                                            "value":  "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), magnetometer=(), gyroscope=()"
                                        }
                                    ]
                    },
                    {
                        "source":  "/(health|ready|version)",
                        "headers":  [
